# --- Never commit these ---

# HTTPS certificates & private keys
backend/cert.pem
backend/key.pem
*.pem

# Live databases (service slips) and SQLite side-files
backend/om_orders.db
backend/om_orders.db-shm
backend/om_orders.db-wal
*.db
*.db-shm
*.db-wal

# Database backups (belong on the server, not in the repo)
backend/backups/
backend/backup.log
backend/backup-last-run.txt

# Logs (service output, price audit log)
backend/service-out.log
backend/service-err.log
backend/price-updates.log
# Who moved a part to which shelf. AutoCount keeps no record of app writes,
# so this is the only one. Never delete it.
backend/location-updates.log
backend/whatsapp-sends.log
backend/autocount-orders.log
*.log

# Dependencies (restored by npm install)
node_modules/
backend/node_modules/

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
__pycache__/

# Web push signing keys — the private half is a credential
backend/vapid.json

# Google service account key — this is the whole credential for the Drive
# folder. Google hands it over as a .json download, and the obvious place to
# drop it is next to the server, so it is ignored by name AND by shape.
backend/drive-key.json
backend/*-service-account*.json
backend/*credentials*.json
